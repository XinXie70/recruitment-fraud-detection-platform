# ============================================================
# Production environment variables — Modify sensitive info before deploying!
# Copy this file to .env then edit: cp .env.prod .env
# ============================================================

# --- Database ---
POSTGRES_DB=fake_job_detection
POSTGRES_USER=postgres
# ⚠️ Must change to a strong password!
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# --- JWT / Security ---
# ⚠️ Generate a random key with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

# --- App Configuration ---
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://YOUR_SERVER_IP:5190,http://localhost:5190
MAX_INPUT_CHARS=50000

# --- Model Inference ---
# Remote model inference server address (provided by model team, e.g. http://10.0.1.100:8001)
# Leave empty to load models locally in the backend process (requires 8GB+ RAM)
MODEL_SERVER_URL=
MODEL_SERVER_TIMEOUT=120
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_WORKERS=4
XAI_USE_SHAP=true

# --- Ollama (optional, disabled by default) ---
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# --- Logging ---
LOG_LEVEL=INFO
