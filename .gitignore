# Full datasets and generated splits stay local. Only tiny fixtures are tracked.
model_algorithm/sprint3/data/raw/*.csv
model_algorithm/sprint3/data/processed/*
model_algorithm/sprint3/data/splits/*
!model_algorithm/sprint3/data/samples/
!model_algorithm/sprint3/data/samples/**
!model_algorithm/sprint3/data/README.md
!model_algorithm/sprint3/data/checksums.sha256
!model_algorithm/sprint3/data/download_data.sh

# Local-only experiment trees
/models/
/outputs/
artifacts/
checkpoints/

# Generic binary dumps outside deliverable weight packs
*.joblib
!model_algorithm/sprint3/LR/weight/
!model_algorithm/sprint3/LR/weight/lr_none_bigram_no_cv_paper_aligned_seed42.joblib
# model_service runtime weights must stay tracked (do not ignore)
!model_service/models/
!model_service/models/**
*.pt
*.pth
*.pkl

# Local environments and temporary files
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.env
.env.*
!.env.example
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
model_service/server.*.log
backend/test.db
*.sqlite
*.sqlite3
*.pid
.DS_Store
.ipynb_checkpoints/
.idea/
.vscode/

# Reproducible experiment outputs may include metrics, predictions, and figures,
# but transient process logs must not be committed.
experiments/**/logs/*
retrain_*/results/logs/*
retrain_*/results/*.log

# Row-level model outputs are reproducible artifacts, not source files.
model_algorithm/sprint3/**/results/*predictions*.csv
model_algorithm/sprint3/**/results/*error_analysis*.csv
model_algorithm/sprint3/**/results/validation_sweep.csv
