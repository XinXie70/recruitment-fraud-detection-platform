# Uncompressed datasets stay local. Compressed experiment inputs may be tracked.
data/raw/*.csv
data/processed/*.csv

# Legacy / local-only experiment trees
/models/
/outputs/
artifacts/
checkpoints/

# Generic binary dumps outside the deliverable weight pack
*.joblib
!model_weights/**/*.joblib
*.pt
*.pth
*.pkl
!model_weights/**/*.pkl

# Local environments and temporary files
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.env
.env.*
!.env.example
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
api_flask/server.*.log
backend/test.db
*.sqlite
*.sqlite3
*.pid
.DS_Store
.ipynb_checkpoints/
.idea/
.vscode/

# Training runtime output is local-only; retain placeholder directories.
model_results/**/logs/*
!model_results/**/logs/.gitkeep

# Reproducible experiment outputs may include metrics, predictions, and figures,
# but transient process logs must not be committed.
experiments/**/logs/*
retrain_*/results/logs/*
retrain_*/results/*.log
