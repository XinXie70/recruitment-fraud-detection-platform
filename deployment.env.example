# Public address used by the browser. Replace this with the final HTTPS URL.
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_PORT=8080

# Use URL-safe random values. Do not commit the real deployment environment file.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
SECRET_KEY=replace-with-a-different-long-random-hex-value
MODEL_API_KEY=replace-with-another-long-random-hex-value

RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_PREDICT_BATCH=300/minute
