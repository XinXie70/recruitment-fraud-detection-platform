# Cloud Run Dockerfile — backend only (no ML deps, no frontend)
# Assumes MODEL_SERVER_URL points to the standalone model inference server.
#
# Build:  docker build -f Dockerfile.cloudrun -t backend .
# Deploy: gcloud run deploy backend --image=... --add-cloudsql-instances=...

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install only lightweight backend dependencies + Cloud SQL Python connector
COPY backend/requirements-cloudrun.txt /app/backend/requirements-cloudrun.txt
RUN pip install --no-cache-dir -r /app/backend/requirements-cloudrun.txt

# Model weights are not copied; inference is delegated to the FP-gate service.
COPY backend /app/backend
RUN chmod +x /app/backend/docker-entrypoint.sh

# Cloud Run provides $PORT (default 8080)
EXPOSE 8080

ENTRYPOINT ["/app/backend/docker-entrypoint.sh"]
CMD ["sh", "-c", \
     "gunicorn backend.main:app \
        --workers ${GUNICORN_WORKERS:-2} \
        --worker-class uvicorn.workers.UvicornWorker \
        --bind 0.0.0.0:${PORT:-8080} \
        --timeout ${GUNICORN_TIMEOUT:-120} \
        --keep-alive 5 \
        --access-logfile - \
        --error-logfile -"]
