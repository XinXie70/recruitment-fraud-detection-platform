# Redirect to backend/Dockerfile.cloudrun — Render-compatible entry point
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY backend/requirements-cloudrun.txt /app/backend/requirements-cloudrun.txt
RUN pip install --no-cache-dir -r /app/backend/requirements-cloudrun.txt

COPY backend /app/backend
COPY model/final_model_pipelines /app/model/final_model_pipelines

EXPOSE 8080

CMD ["sh", "-c", \
     "gunicorn backend.main:app \
        --workers ${GUNICORN_WORKERS:-2} \
        --worker-class uvicorn.workers.UvicornWorker \
        --bind 0.0.0.0:${PORT:-8080} \
        --timeout ${GUNICORN_TIMEOUT:-120} \
        --keep-alive 5 \
        --access-logfile - \
        --error-logfile -"]
