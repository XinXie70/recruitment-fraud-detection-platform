# Large project trees that are not required by any production image
model_algorithm/
data/
exports/
paper_comparison/
reports/

# Do not exclude backend/ or frontend/ here. The Cloud Run Dockerfiles use the
# repository root as their build context and copy those directories explicitly.

# Large split dumps
**/*.csv.gz
**/data/splits/

# Model weights/configs ship inside model_service/models/.

# Local API runtime noise
model_service/server.*.log
model_service/*.log
