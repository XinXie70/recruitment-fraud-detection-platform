
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --system app && useradd --system --gid app --no-create-home app

# The canonical backend requirements contain no model-runtime dependencies.
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# Model weights are not copied; inference is delegated to the FP-gate service.
COPY --chown=app:app backend /app/backend
RUN chmod +x /app/backend/docker-entrypoint.sh

USER app

EXPOSE 8000

# Render provides $PORT env var; fall back to 8000 for local dev
ENTRYPOINT ["/app/backend/docker-entrypoint.sh"]
CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
