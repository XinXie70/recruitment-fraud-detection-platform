# Slim backend image — no ML dependencies, delegates inference to a remote model server.
# Set MODEL_SERVER_URL to the model server address.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install only lightweight backend dependencies (no TensorFlow / PyTorch / transformers)
COPY backend/requirements-remote.txt /app/backend/requirements-remote.txt
RUN pip install --no-cache-dir -r /app/backend/requirements-remote.txt

# Copy backend source and model utility code (risk_mapping, validation_pipeline, etc.)
# Model weights are NOT copied — inference is delegated to the remote model server.
COPY backend /app/backend
COPY model/final_model_pipelines /app/model/final_model_pipelines

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
