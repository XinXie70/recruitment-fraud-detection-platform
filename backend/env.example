DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fake_job_detection
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ISSUER=fake-job-detection-api
JWT_AUDIENCE=fake-job-detection-client
# Dedicated admin account (configure all three; do not commit real credentials)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-Admin-password-123
CORS_ORIGINS=http://127.0.0.1:5190,http://localhost:5190
MAX_INPUT_CHARS=50000
XAI_MAX_ITEMS=10
XAI_MAX_EVALS=200
XAI_HIERARCHICAL_MIN_WORDS=250
XAI_HIERARCHICAL_TOP_SEGMENTS=2
XAI_HIERARCHICAL_SEGMENT_WORDS=35
XAI_HIERARCHICAL_MAX_EVALS=160
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=8
# Caching
ANALYSIS_CACHE_TTL_SECONDS=300
ANALYSIS_CACHE_MAX_ENTRIES=1024
# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
# Required BERT-primary + LR false-positive-gate model service.
MODEL_SERVER_URL=http://127.0.0.1:5000
MODEL_SERVER_TIMEOUT=120
