# ==== Database ====
# Local development: use the local postgres started by docker compose
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fake_job_detection
#
# Production (Supabase free PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Note: Use Session Pooler port 6543, not 5432
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://127.0.0.1:5190,http://localhost:5190
MAX_INPUT_CHARS=50000
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_WORKERS=3
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
CORS_ORIGINS=http://127.0.0.1:5190,http://localhost:5190
MAX_INPUT_CHARS=50000
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_WORKERS=3
ENSEMBLE_CONFIG_PATH=
XAI_USE_SHAP=true
XAI_MAX_ITEMS=10
XAI_MAX_SEGMENTS=80
XAI_MAX_EVALS=200
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=8
# Remote model server (leave empty to load models locally)
MODEL_SERVER_URL=
MODEL_SERVER_TIMEOUT=120
# Dockerfile: backend/Dockerfile.remote (slim) or backend/Dockerfile (with ML deps)
BACKEND_DOCKERFILE=backend/Dockerfile
